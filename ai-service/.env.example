# Local default. Production requires PostgreSQL with verified TLS.
APP_ENV=development
# Supabase: copy Session pooler PostgreSQL URI, add verified TLS (see README.md).
# Database password belongs only in .env, never here.
DATABASE_URL=
# Generate a private random value of at least 32 characters; share only with the backend team.
LEMS_SERVICE_API_KEY=

MODEL_PROVIDER=openrouter
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=

# Optional explicit alternative: MODEL_PROVIDER=azure
AZURE_OPENAI_BASE_URL=https://lems-ai-dev.services.ai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_KEY=

# summary: original short text; full: separately indexed whole documents.
RETRIEVAL_MODE=full
