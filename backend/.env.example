# Copy to .env and fill in real cloud credentials. Never commit .env.
Databases__Core__ConnectionString=Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=lems_core;User ID=lems_app;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
Databases__Ops__ConnectionString=Host=YOUR-INSTANCE.xxxxxx.eu-central-1.rds.amazonaws.com;Port=5432;Database=lems_ops;Username=lems_app;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=false

# Must match LEMS_SERVICE_API_KEY in ai-service/.env.
AiService__ServiceKey=YOUR_SHARED_SERVICE_KEY

# Required to create the first administrator in the production container.
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=REPLACE_WITH_STRONG_PASSWORD

# ---- E-mail notifications (optional). Leave Smtp__Host empty to switch e-mails off. ----
# Booking e-mails go to students who have notifications enabled in their profile; a confirmed booking carries an .ics calendar file.
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=LEMS <no-reply@your-domain.sk>
Smtp__PublicUrl=http://localhost:5000
