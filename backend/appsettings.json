{
  "Databases": {
    "Core": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=lems-core.db"
    },
    "Ops": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=lems-ops.db"
    }
  },
  "AiService": {
    "BaseUrl": "http://127.0.0.1:8000",
    "ServiceKey": ""
  },
  "Lems": {
    "OpenHour": 8,
    "CloseHour": 20,
    "PendingTimeoutHours": 24,
    "MaxDaysAhead": 60
  },
  "Security": {
    "RequireHttps": false,
    "BehindProxy": false,
    "IdleMinutes": 480,
    "AbsoluteHours": 24
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "LEMS <no-reply@lems.local>",
    "PublicUrl": ""
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}